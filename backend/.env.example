# Copie ce fichier en .env et adapte les valeurs.
# Ne JAMAIS committer le vrai fichier .env (voir .gitignore).

DJANGO_SECRET_KEY=change-moi
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=sunu_mall
POSTGRES_USER=sunu_mall
POSTGRES_PASSWORD=sunu_mall
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sunu-mall-media
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=False
MINIO_PUBLIC_ENDPOINT=localhost:9010

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3010,http://localhost:3011,http://localhost:8081

# Doit correspondre au port réel du frontend Vite (frontend/vite.config.ts : server.port)
FRONTEND_URL=http://localhost:3004

# Clé API Anthropic (Claude) — génération de description produit + assistant
# client (apps/ia/). Générer la tienne sur console.anthropic.com.
ANTHROPIC_API_KEY=

# SMTP réel — sans ça, EMAIL_BACKEND retombe sur le backend "console"
# (rien n'est réellement délivré, juste imprimé dans les logs). Pour
# Gmail : active la validation en 2 étapes puis génère un mot de passe
# d'application sur https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Paiement : mettre à True pour les tests sandbox, False en production
PAYMENT_SANDBOX=True

# --- Passerelles réelles (PAYMENT_SANDBOX=False obligatoire pour activer) ---
# Wave : clé marchande + secret des webhooks (portail business.wave.com).
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Orange Money : OAuth2 client_id/client_secret + merchant_key d'onboarding.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY_PATH=sn
ORANGE_MONEY_CURRENCY=XOF
# BACKEND_URL = URL publique de l'API (notif_url Orange Money, webhook Wave).
BACKEND_URL=http://localhost:8080/api
