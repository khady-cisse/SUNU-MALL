# =========================================================
# SUNU MALL — Variables d'environnement PostgreSQL (TEMPLATE)
# =========================================================

# Base créée au premier démarrage du conteneur (copiez ce fichier vers
# postgres.env et changez le mot de passe — le backend lit le même).
POSTGRES_DB=sunu_mall
POSTGRES_USER=sunu_mall
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-securise

# En PROD : ne PAS activer "trust". Sans cette variable, Postgres utilise
# l'authentification par mot de passe (scram-sha-256), ce qui est le bon
# comportement. La valeur "trust" n'est utile qu'en développement isolé.
# POSTGRES_HOST_AUTH_METHOD=trust